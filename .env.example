# Copy to .env and fill in real values before running docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=
# Required: startup fails if unset.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
# Prod only (config.settings.prod): True/False
SECURE_SSL_REDIRECT=

# --- JWT (SimpleJWT) lifetimes, in minutes ---
ACCESS_TOKEN_LIFETIME=
REFRESH_TOKEN_LIFETIME=

# --- Database (Postgres) ---
# Required unless USE_SQLITE=True: startup fails if unset.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# DEV-ONLY: set USE_SQLITE=True to run manage.py commands (check,
# makemigrations, test) against local SQLite when Docker/Postgres aren't
# available, e.g. on a bare dev machine. Never set this in
# docker-compose/production. See backend/config/settings/base.py.
USE_SQLITE=

# --- CORS ---
CORS_ALLOWED_ORIGINS=

# --- Frontend ---
VITE_API_BASE_URL=
